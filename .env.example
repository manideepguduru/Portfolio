# ============================================
# PostgreSQL Render Credentials
# ============================================
# Copy these to Render Environment Variables
# Replace values with your actual Render credentials

SPRING_DATASOURCE_URL=postgresql://your_db_user:your_db_password@your_db_host/your_db_name

SPRING_DATASOURCE_USERNAME=your_db_username

SPRING_DATASOURCE_PASSWORD=your_db_password

# Frontend Vercel URL (set after deploying frontend)
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app

# Local Development (optional)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/portfolio_db
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=postgres
